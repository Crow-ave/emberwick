{
  "name": "emberwick",
  "version": "1.4.1",
  "description": "A living village economy on NEAR",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "demo": "EMBERWICK_DEMO=1 node server/index.js",
    "online-bank": "EMBERWICK_KEYS=$HOME/.emberwick/online-keys.json EMBERWICK_SAVE=$HOME/.emberwick/online-state.json EMBERWICK_AI=0 PORT=3001 node server/index.js",
    "test": "node server/selftest.js && node server/neartest.js"
  },
  "dependencies": {
    "near-api-js": "7.4.0"
  },
  "engines": { "node": ">=22" },
  "license": "MIT"
}
